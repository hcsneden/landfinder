{
  "name": "lastbestland",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "infrastructure"
  ],
  "scripts": {
    "web": "npm run dev --workspace=apps/web",
    "web:build": "npm run build --workspace=apps/web",
    "mobile": "npm run start --workspace=apps/mobile",
    "infra:deploy": "npm run deploy --workspace=infrastructure",
    "infra:synth": "npm run synth --workspace=infrastructure",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w packages/shared -w services/api -w services/scrapers -w apps/web -w infrastructure",
    "typecheck:mobile": "npm run typecheck -w apps/mobile",
    "test": "vitest run",
    "test:go": "cd services/parcel-go && go test ./..."
  },
  "overrides": {
    "@types/react": "19.2.17"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "19.2.17",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
